{
  "manifest_version": 3,
  "name": "xFang",
  "version": "1.1.0",
  "description": "Defang or refang URLs, domains, IPs and emails in form fields with a shortcut or right-click.",
  "permissions": [
    "contextMenus"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "fang.js",
        "content.js"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "toggle-fang": {
      "suggested_key": {
        "default": "Alt+Shift+D"
      },
      "description": "Defang or refang the selected text"
    }
  }
}
